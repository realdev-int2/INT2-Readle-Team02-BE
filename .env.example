# Local MySQL (docker compose)
MYSQL_DATABASE=readle
MYSQL_USER=readleuser
MYSQL_PASSWORD=readle_local_password
MYSQL_ROOT_PASSWORD=readle_local_root_password

# Spring Boot runs on the host; therefore it connects to localhost, not the Compose service name.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/readle?serverTimezone=Asia/Seoul\&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=readleuser
SPRING_DATASOURCE_PASSWORD=readle_local_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1

# Local security values. Do not use these values outside local development.
# Replace OAUTH_STATE_ENCRYPTION_KEY with one `openssl rand -base64 32` output outside local development.
# It must be standard Base64 that decodes to a 16-, 24-, or 32-byte AES key.
JWT_ISSUER=readle
JWT_SECRET=local-dev-jwt-secret-change-me-1234
OAUTH_STATE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAA==
BACKEND_ORIGIN=http://localhost:8080
# Explicit protected-route allowlist. Query strings are preserved after the path check.
OAUTH_ALLOWED_RETURN_PATHS=/,/learn,/contents/**,/quizzes/**,/quiz-attempts/**,/result-reports/**,/dashboard,/history

# LocalStack S3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-northeast-2
S3_BUCKET=readle-local
S3_ENDPOINT=http://localhost:4566

# Required to use AI validation, quiz generation, and AI grading.
CLAUDE_API_KEY=

# Required only to test each OAuth login flow.
# Register the callback URI as http://localhost:8080/api/auth/{provider}/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Vite development server origins used by LocalStack CORS bootstrap.
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN_ALT=http://127.0.0.1:3000
